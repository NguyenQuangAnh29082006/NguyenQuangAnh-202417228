import java.util.Scanner;

public class DaysOfMonth {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int year = -1;
        int month = -1;

        while (true) {
           
            System.out.print("Nhập năm (ví dụ: 1999): ");
            String yearInput = sc.nextLine().trim();
            if (yearInput.matches("\\d+")) { 
                year = Integer.parseInt(yearInput);
            } else {
                System.out.println("Năm không hợp lệ. Vui lòng nhập lại.");
                continue;
            }

           
            System.out.print("Nhập tháng (Tên, Viết tắt, hoặc Số): ");
            String monthInput = sc.nextLine().trim();
            month = getMonthNumber(monthInput);

            if (month == -1) {
                System.out.println("Tháng không hợp lệ. Vui lòng nhập lại.");
                continue;
            }

          
            break;
        }

       
        int days = calculateDays(month, year);
        System.out.println("Số ngày của tháng " + month + " năm " + year + " là: " + days);
        
        sc.close();
    }

  
    public static int getMonthNumber(String input) {
        String lowerInput = input.toLowerCase();
        
     
        if (lowerInput.matches("\\d+")) {
            int m = Integer.parseInt(lowerInput);
            return (m >= 1 && m <= 12) ? m : -1;
        }

       
        switch (lowerInput) {
            case "january": case "jan.": case "jan": return 1;
            case "february": case "feb.": case "feb": return 2;
            case "march": case "mar.": case "mar": return 3;
            case "april": case "apr.": case "apr": return 4;
            case "may": return 5;
            case "june": case "jun": return 6;
            case "july": case "jul": return 7;
            case "august": case "aug.": case "aug": return 8;
            case "september": case "sept.": case "sep": return 9;
            case "october": case "oct.": case "oct": return 10;
            case "november": case "nov.": case "nov": return 11;
            case "december": case "dec.": case "dec": return 12;
            default: return -1;
        }
    }

    
    public static boolean isLeapYear(int year) {
        if (year % 4 == 0) {
            if (year % 100 == 0) {
                return year % 400 == 0;
            }
            return true;
        }
        return false;
    }

 
    public static int calculateDays(int month, int year) {
        switch (month) {
            case 4: case 6: case 9: case 11:
                return 30;
            case 2:
                return isLeapYear(year) ? 29 : 28;
            default:
                return 31;
        }
    }
}
